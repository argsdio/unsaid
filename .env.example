# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Grok (SpaceXAI). Without this the agents fall back to deterministic scoring
# and offline slot extraction, so the harness still runs.
XAI_API_KEY=
GROK_MODEL=grok-4

# MongoDB Atlas. Without this everything runs in memory.
MONGODB_URI=
MONGODB_DB=unsaid

# Optional Capital One Nessie key. Without it, each phone hashes onto a local
# fake dinner ledger so the budget question still names Nessie on stage.
NESSIE_API_KEY=

# Native iMessage polls. Photon echoes them with an empty title; Unsaid patches
# that in Spectrum so taps still count. Set to 0 to send only the numbered list.
# UNSAID_POLL=0

# Google Places, for `npm run venues` ONLY. The app never reads this: the
# catalogue it builds is committed as src/venues.json, so nothing at runtime
# needs a key, a quota or a network call. Enable "Places API (New)" in Google
# Cloud, then restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# Silences the running commentary. `npm run demo` sets it for itself.
UNSAID_QUIET=
